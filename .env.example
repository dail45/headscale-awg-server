# Tailscale Exit Node configuration template
# Copy to .env and adjust values for your server
# TS_AUTHKEY: Leave empty for manual web authentication, or generate one:
# docker compose exec headscale headscale preauthkeys create --user <username> --reusable --expiration 24h
TS_AUTHKEY=
TS_EXTRA_ARGS=--login-server=https://hs.yourdomain.com --advertise-exit-node --reset
